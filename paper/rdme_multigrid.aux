\citation{peles}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {(a)} Fine-level state-space size over time. V-cycle methods grow to ${\sim }5\times 10^5$ fine states by $t=2$; coarse-only methods maintain ${\lesssim }10^3$ coarse states. \textbf  {(b)} TV distance vs.\ pair-level ground truth. All four methods produce similar TV values ($0.85$--$0.97$) because the error is dominated by inter-pair coupling (the independence assumption in the proxy GT) rather than prolongation error. Dynamic-$\pi $ V-cycle runs $5\times $ faster than Binomial V-cycle (5.4\,s vs.\ 27.9\,s) with a smaller fine state space (506k vs.\ 576k states).\relax }}{21}{figure.caption.183}\protected@file@percent }
\newlabel{fig:vcycle-accuracy}{{6}{21}{\textbf {(a)} Fine-level state-space size over time. V-cycle methods grow to ${\sim }5\times 10^5$ fine states by $t=2$; coarse-only methods maintain ${\lesssim }10^3$ coarse states. \textbf {(b)} TV distance vs.\ pair-level ground truth. All four methods produce similar TV values ($0.85$--$0.97$) because the error is dominated by inter-pair coupling (the independence assumption in the proxy GT) rather than prolongation error. Dynamic-$\pi $ V-cycle runs $5\times $ faster than Binomial V-cycle (5.4\,s vs.\ 27.9\,s) with a smaller fine state space (506k vs.\ 576k states).\relax }{figure.caption.183}{}}
\newlabel{fig:vcycle-accuracy@cref}{{[figure][6][]6}{[1][19][]21}}
