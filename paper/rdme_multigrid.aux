\@writefile{toc}{\contentsline {paragraph}{Failure of Binomial prolongation.}{17}{section*.176}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Dynamic-$\pi $ prolongation.}{18}{section*.177}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Conditional distribution $p(n_1 \mid n_c = 193)$ for three prolongation methods at $t = 0.5$. Binomial($193$, $\frac  {1}{2}$) concentrates all mass at the wrong location $n_1 = 96$. Dynamic-$\pi $ (stationary) correctly identifies both stable states at $n_1 \approx 31$ and $n_1 \approx 162$, but assigns 50\% weight to each (symmetry trap). The true conditional (direct FSP) is concentrated near $n_1 = 31$ since the initial condition has molecules in the low-state voxel.\relax }}{18}{figure.caption.178}\protected@file@percent }
\newlabel{fig:prolongation-failure}{{2}{18}{Conditional distribution $p(n_1 \mid n_c = 193)$ for three prolongation methods at $t = 0.5$. Binomial($193$, $\frac {1}{2}$) concentrates all mass at the wrong location $n_1 = 96$. Dynamic-$\pi $ (stationary) correctly identifies both stable states at $n_1 \approx 31$ and $n_1 \approx 162$, but assigns 50\% weight to each (symmetry trap). The true conditional (direct FSP) is concentrated near $n_1 = 31$ since the initial condition has molecules in the low-state voxel.\relax }{figure.caption.178}{}}
\newlabel{fig:prolongation-failure@cref}{{[figure][2][]2}{[1][18][]18}}
\@writefile{toc}{\contentsline {paragraph}{Benchmark 2b: Two-Level V-Cycle ($K=4 \to K=2$).}{18}{section*.181}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Joint fine-level distribution $p(n_1, n_2)$ at $t = 0.5$ for the $K=2$ Schlögl front IC $(n_1,n_2)=(31,162)$. \textbf  {(a)} Direct FSP (ground truth): mass concentrated at $(31,162)$. \textbf  {(b)} Restrict $\to $ Binomial-$\pi $ prolong: wrong location $(96,97)$; TV$=1.000$. \textbf  {(c)} Restrict $\to $ Dynamic-$\pi $ prolong: bimodal at $(31,162)$ and $(162,31)$; TV$=0.798$. White cross marks the initial condition. Color scale clipped at 70\% of peak for visibility.\relax }}{19}{figure.caption.179}\protected@file@percent }
\newlabel{fig:heatmap-comparison}{{3}{19}{Joint fine-level distribution $p(n_1, n_2)$ at $t = 0.5$ for the $K=2$ Schlögl front IC $(n_1,n_2)=(31,162)$. \textbf {(a)} Direct FSP (ground truth): mass concentrated at $(31,162)$. \textbf {(b)} Restrict $\to $ Binomial-$\pi $ prolong: wrong location $(96,97)$; TV$=1.000$. \textbf {(c)} Restrict $\to $ Dynamic-$\pi $ prolong: bimodal at $(31,162)$ and $(162,31)$; TV$=0.798$. White cross marks the initial condition. Color scale clipped at 70\% of peak for visibility.\relax }{figure.caption.179}{}}
\newlabel{fig:heatmap-comparison@cref}{{[figure][3][]3}{[1][18][]19}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces TV distance vs.\ direct FSP for the $K=2$ coarse MSA methods. Binomial-$\pi $ is consistently TV$=1$ (completely wrong). Dynamic-$\pi $ achieves TV$\approx 0.80$--$0.70$, improving over time as the distribution relaxes toward the stationary regime where the symmetric prolongation is more accurate.\relax }}{19}{figure.caption.180}\protected@file@percent }
\newlabel{fig:msa-tv-decay}{{4}{19}{TV distance vs.\ direct FSP for the $K=2$ coarse MSA methods. Binomial-$\pi $ is consistently TV$=1$ (completely wrong). Dynamic-$\pi $ achieves TV$\approx 0.80$--$0.70$, improving over time as the distribution relaxes toward the stationary regime where the symmetric prolongation is more accurate.\relax }{figure.caption.180}{}}
\newlabel{fig:msa-tv-decay@cref}{{[figure][4][]4}{[1][18][]19}}
