\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Sparsity pattern of the generator $\mathbf  {A}$ for the bottleneck network (Figure\nobreakspace  {}\ref {fig:bottleneck}), ordered as $[s_1,s_2,s_b,s_3,s_4]$. Black cells are nonzero entries; white cells are zero. Dashed boxes mark the two metastable regions. \textbf  {(a)} With $s_b$: the $s_b$ row and column (index 3) bridge both regions, making $\mathbf  {A}$ irreducible. \textbf  {(b)} Without $s_b$: the generator is exactly block-diagonal; the two metastable regions are disconnected and probability cannot flow between them.\relax }}{8}{figure.caption.47}\protected@file@percent }
\newlabel{fig:generator-sparsity}{{3}{8}{Sparsity pattern of the generator $\mathbf {A}$ for the bottleneck network (Figure~\ref {fig:bottleneck}), ordered as $[s_1,s_2,s_b,s_3,s_4]$. Black cells are nonzero entries; white cells are zero. Dashed boxes mark the two metastable regions. \textbf {(a)} With $s_b$: the $s_b$ row and column (index 3) bridge both regions, making $\mathbf {A}$ irreducible. \textbf {(b)} Without $s_b$: the generator is exactly block-diagonal; the two metastable regions are disconnected and probability cannot flow between them.\relax }{figure.caption.47}{}}
