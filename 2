def_model = begin
  rn = @reaction_network begin
    k1, S + E --> SE
    k2, SE --> S + E 
    k3, SE --> P + E 
  end
  model = DiscStochSim.DiscreteStochasticSystem(rn)
end

def_boundary = begin
  # define function that charctarizes global hard boundary
  bounds = (0, 200)
  boundary_condition(x) = RectLatticeBoundaryCondition(x, bounds)
end

