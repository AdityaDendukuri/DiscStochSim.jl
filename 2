  dt = 0.001 
  U0 = CartesianIndex(50, 10, 1, 1)
  rates = [0.01, 0.1, 0.1] 
  X = Set([U0])
  p = [1.0]
end

build_matrix = begin
  X = DiscStochSim.expand!(X, p, model, boundary_condition, dt)
  local A, _, _ = MasterEquation(S, model, rates, boundary_condition, dt) 
end


block_approach = begin
  E = sprand(length(A), length(A))
  O = copy(E) .* 0
